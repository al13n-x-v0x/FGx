      <Item class="ModuleScript" referent="RBX61">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source">--[[
	Config.lua (ModuleScript -&gt; ReplicatedStorage/Shared)
	Central configuration for STRIKE//ZERO. Everything designers are expected
	to tweak lives here or in WeaponConfig / CombatConfig.
]]

local Config = {}

Config.GameName = "STRIKE//ZERO"
Config.Version = "0.1.0"

-- Teams ----------------------------------------------------------------------
-- Teams are created server-side by PlayerService using these definitions.
Config.Teams = {
	{ id = "BLAZE", color = "Bright orange" },
	{ id = "FROST", color = "Bright blue" },
}

-- Player ---------------------------------------------------------------------
Config.MaxHealth = 100
Config.SpawnForceFieldTime = 3 -- seconds of spawn protection

-- Movement (simulated on the owning client; server only sets base values) ----
Config.Movement = {
	walkSpeed = 16,
	sprintSpeed = 25,
	sprintFovBoost = 8,
	sprintFovTime = 0.15,
	slideBurstSpeed = 34,
	slideSpeed = 12,
	slideDuration = 0.9,
	slideCooldown = 0.8,
	slideMinSpeed = 20, -- must be sprinting this fast to slide
	jumpPower = 50,
	crouchCameraOffset = 1.9, -- studs the camera drops while sliding
}

-- Match (Team Deathmatch) -----------------------------------------------------
Config.Match = {
	scoreLimit = 30,
	timeLimit = 300, -- seconds
	respawnDelay = 4,
	intermission = 6, -- seconds between matches
	minPlayers = 1,
}

-- Combat --------------------------------------------------------------------
Config.Combat = {
	friendlyFire = false,
	maxShotOriginDistance = 10, -- server rejects fire origins farther than this from the head
	minShotDot = -0.5, -- shots must be roughly forward of the body
	hitConfirmCooldown = 0.05,
}

-- Admin ----------------------------------------------------------------------
-- Add your Roblox UserId here, e.g. Admins = { [1234567] = true }
-- Private-server owners are always allowed. In Studio, everyone is allowed.
Config.Admins = {}

-- Audio placeholders ---------------------------------------------------------
-- Drop in your own asset ids (rbxassetid://...). Empty string = silent hook.
-- Categories are kept separate so sounds can be swapped independently.
Config.Audio = {
	gunshot = "",
	reload = "",
	hit = "",
	kill = "",
	melee = "",
	slide = "",
	ui = "",
	footstep = "",
}

-- Graphics presets (applied client-side by UIController) ---------------------
Config.Graphics = {
	LOW = {
		shadows = false,
		postEffects = false,
		mapMaterials = false, -- flatten map materials locally (fewer texture samples)
		fogEnd = 1200,
		fovBoost = 0,
	},
	MEDIUM = {
		shadows = false,
		postEffects = false,
		mapMaterials = true,
		fogEnd = 100000,
		fovBoost = 0,
	},
	HIGH = {
		shadows = true,
		postEffects = true,
		mapMaterials = true,
		fogEnd = 100000,
		fovBoost = 0,
	},
}
Config.DefaultGraphics = "LOW"

return Config
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX62">
        <Properties>
          <string name="Name">WeaponConfig</string>
          <string name="Source">--[[
	WeaponConfig.lua (ModuleScript -&gt; ReplicatedStorage/Shared)
	Modular weapon framework. To add a weapon: add an entry to Weapons with
	the same shape and (optionally) a viewmodel blueprint. No other file needs
	to change for a new gun to be droppable via !giveweapon.
]]

local WeaponConfig = {}

-- Viewmodel blueprints -------------------------------------------------------
-- Camera-space parts: size = {x,y,z}, color = {r,g,b}, offset = {x,y,z}
-- Offsets are relative to the viewmodel root (right, down, forward).
local function gunBody(barrelColor)
	return {
		{ size = { 0.35, 0.5, 1.5 }, color = { 45, 45, 50 }, offset = { 0.42, -0.42, -1.1 } },   -- receiver
		{ size = { 0.16, 0.16, 1.1 }, color = barrelColor, offset = { 0.42, -0.34, -2.1 } },    -- barrel
		{ size = { 0.26, 0.55, 0.32 }, color = { 35, 35, 40 }, offset = { 0.42, -0.78, -0.85 } },-- grip/mag
		{ size = { 0.1, 0.14, 0.3 }, color = { 200, 200, 205 }, offset = { 0.42, -0.13, -1.35 } },-- sight
	}
end

WeaponConfig.Weapons = {
	-- Slot 1: assault rifle ---------------------------------------------------
	ar = {
		id = "ar",
		name = "VK-7 RIFLE",
		slot = 1,
		kind = "gun",
		damage = 24,
		fireRate = 0.1,      -- seconds between shots (600 RPM)
		mag = 30,
		reserve = 90,
		reloadTime = 2.2,
		auto = true,
		recoilUp = 1.15,     -- degrees of camera kick per shot
		recoilSide = 0.4,
		spread = 0.9,        -- degrees
		range = 320,
		headshot = 2.0,
		pellets = 1,
		muzzle = { color = { 255, 200, 90 }, size = 0.28, time = 0.05 },
		viewmodel = gunBody({ 90, 95, 100 }),
	},

	-- Slot 1: SMG -------------------------------------------------------------
	smg = {
		id = "smg",
		name="WASP SMG",
		slot = 1,
		kind = "gun",
		damage = 17,
		fireRate = 0.075,    -- 800 RPM
		mag = 25,
		reserve = 100,
		reloadTime = 1.8,
		auto = true,
		recoilUp = 0.75,
		recoilSide = 0.55,
		spread = 1.5,
		range = 150,
		headshot = 1.8,
		pellets = 1,
		muzzle = { color = { 255, 190, 80 }, size = 0.22, time = 0.04 },
		viewmodel = gunBody({ 70, 72, 78 }),
	},

	-- Slot 1: shotgun ---------------------------------------------------------
	shotgun = {
		id = "shotgun",
		name = "BREAKER-8",
		slot = 1,
		kind = "gun",
		damage = 11,         -- per pellet
		fireRate = 0.85,
		mag = 6,
		reserve = 24,
		reloadTime = 2.8,
		auto = false,
		recoilUp = 3.2,
		recoilSide = 0.9,
		spread = 4.0,        -- degrees, applied per pellet
		range = 70,
		headshot = 1.5,
		pellets = 8,
		muzzle = { color = { 255, 170, 60 }, size = 0.4, time = 0.07 },
		viewmodel = gunBody({ 120, 80, 50 }),
	},

	-- Slot 2: secondary -------------------------------------------------------
	pistol = {
		id = "pistol",
		name = "M1 SIDEARM",
		slot = 2,
		kind = "gun",
		damage = 26,
		fireRate = 0.18,
		mag = 12,
		reserve = 48,
		reloadTime = 1.5,
		auto = false,
		recoilUp = 1.6,
		recoilSide = 0.3,
		spread = 1.0,
		range = 160,
		headshot = 2.0,
		pellets = 1,
		muzzle = { color = { 255, 210, 110 }, size = 0.2, time = 0.04 },
		viewmodel = {
			{ size = { 0.3, 0.42, 0.8 }, color = { 50, 50, 55 }, offset = { 0.42, -0.45, -0.85 } },
			{ size = { 0.13, 0.13, 0.55 }, color = { 110, 110, 118 }, offset = { 0.42, -0.36, -1.4 } },
			{ size = { 0.24, 0.5, 0.3 }, color = { 35, 35, 40 }, offset = { 0.42, -0.8, -0.65 } },
		},
	},

	-- Slot 3: melee -----------------------------------------------------------
	knife = {
		id = "knife",
		name = "TANTO",
		slot = 3,
		kind = "melee",
		viewmodel = {
			{ size = { 0.1, 0.1, 1.0 }, color = { 210, 214, 220 }, offset = { 0.45, -0.5, -1.15 } }, -- blade
			{ size = { 0.14, 0.14, 0.4 }, color = { 40, 40, 45 }, offset = { 0.45, -0.5, -0.5 } },   -- grip
		},
	},
}

-- Default loadout ------------------------------------------------------------
WeaponConfig.Loadout = { "ar", "pistol", "knife" }

-- Teammate-safe aliases: what !giveweapon accepts ----------------------------
WeaponConfig.ById = WeaponConfig.Weapons

function WeaponConfig.get(id)
	return WeaponConfig.Weapons[id]
end

-- Resolve a slot number to a weapon id (nil if empty slot) -------------------
function WeaponConfig.slotWeapon(loadout, slot)
	return loadout[slot]
end

return WeaponConfig
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX63">
        <Properties>
          <string name="Name">CombatConfig</string>
          <string name="Source">--[[
	CombatConfig.lua (ModuleScript -&gt; ReplicatedStorage/Shared)
	Melee combo tuning, block/parry rules and server validation tolerances.
	Numbers are deliberately small and readable: tune fights here.
]]

local CombatConfig = {}

-- Melee attacks --------------------------------------------------------------
-- comboDamage: damage per chain index for light attacks (3-hit chain).
CombatConfig.Light = {
	cooldown = 0.34,      -- seconds between light swings
	comboWindow = 0.7,    -- land the next swing inside this window to chain
	comboDamage = { 20, 20, 32 }, -- third hit finishes harder
	range = 8,
	minDot = 0.45,        -- target must be roughly in front (directional attacks)
	stun = 0.5,           -- seconds of slowed movement on the victim
	knockback = 26,
	hitStunDamageScale = 1.0,
}

CombatConfig.Heavy = {
	cooldown = 0.9,
	windup = 0.28,        -- brief delay before the hit resolves (client animates it)
	range = 8.5,
	minDot = 0.4,
	damage = 45,
	stun = 0.9,
	knockback = 62,
}

-- Gun-butt: available only when the equipped gun has EXACTLY 0 in the mag.
CombatConfig.GunButt = {
	cooldown = 0.6,
	range = 7.5,
	minDot = 0.4,
	damage = 30,
	stun = 0.6,
	knockback = 55,
}

-- Block / parry --------------------------------------------------------------
CombatConfig.Block = {
	damageReduction = 0.75, -- blocked melee takes 25% damage
	parryWindow = 0.22,      -- blocking this soon after the enemy swing starts = parry
	parryStun = 1.4,         -- attacker is staggered this long
	parryKnockback = 40,
}

-- Server-side validation tolerances -----------------------------------------
CombatConfig.Validate = {
	fireRateTolerance = 0.06,  -- extra seconds allowed on top of weapon fireRate (network jitter)
	meleeCooldownTolerance = 0.1,
	maxMeleeTargetsPerSwing = 1,
	reloadTolerance = 0.1,
}

-- Hit stun applies a temporary WalkSpeed multiplier to the victim.
CombatConfig.StunSpeedScale = 0.45

return CombatConfig
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX64">
        <Properties>
          <string name="Name">Utility</string>
          <string name="Source">--[[
	Utility.lua (ModuleScript -&gt; ReplicatedStorage/Shared)
	Small shared helpers: signals, math, team lookups, server rate limiting,
	and placeholder audio playback. No game logic lives here.
]]

local Config = require(script.Parent.Config)

local Utility = {}

-- Math -----------------------------------------------------------------------
function Utility.clamp(v, lo, hi)
	if v &lt; lo then
		return lo
	elseif v &gt; hi then
		return hi
	end
	return v
end

function Utility.lerp(a, b, t)
	return a + (b - a) * t
end

function Utility.formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

-- Signal ---------------------------------------------------------------------
-- Minimal connect/fire signal used to wire services and controllers together.
-- Connections are stored per-signal; callers disconnect on teardown to avoid
-- leaks (the memory-leak rule from the design doc).
local Signal = {}
Signal.__index = Signal

function Utility.newSignal()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn)
	local handlers = self._handlers
	handlers[fn] = true
	local conn = {}
	conn.Connected = true
	conn.Disconnect = function()
		conn.Connected = false
		handlers[fn] = nil
	end
	return conn
end

function Signal:Fire(...)
	-- snapshot so handlers can disconnect during fire
	local snapshot = {}
	for fn in pairs(self._handlers) do
		snapshot[#snapshot + 1] = fn
	end
	for i = 1, #snapshot do
		local ok, err = pcall(snapshot[i], ...)
		if not ok then
			warn("[STRIKE//ZERO] signal handler error: " .. tostring(err))
		end
	end
end

-- Event hub (named signals) used by the client bootstrap ---------------------
function Utility.newHub()
	local hub = { _signals = {} }
	function hub:on(name, fn)
		local sig = self._signals[name]
		if sig == nil then
			sig = Utility.newSignal()
			self._signals[name] = sig
		end
		return sig:Connect(fn)
	end
	function hub:emit(name, ...)
		local sig = self._signals[name]
		if sig then
			sig:Fire(...)
		end
	end
	return hub
end

-- Teams ----------------------------------------------------------------------
function Utility.getTeamId(player)
	if player.Team then
		return player.Team.Name
	end
	return nil
end

function Utility.areEnemies(a, b)
	if a == b then
		return false
	end
	local ta, tb = Utility.getTeamId(a), Utility.getTeamId(b)
	if ta == nil or tb == nil then
		return true -- free-for-all fallback (never used in TDM, but safe)
	end
	return ta ~= tb
end

-- Server rate limiting (token bucket, event-driven: no loops) ---------------
local buckets = {}

function Utility.allow(key, rate, burst)
	-- returns true if `key` may perform an action at `rate` events/second,
	-- allowing a short burst of `burst`.
	local now = os.clock()
	local b = buckets[key]
	if b == nil then
		b = { tokens = burst, at = now }
		buckets[key] = b
	end
	local refill = (now - b.at) * rate
	b.tokens = math.min(burst, b.tokens + refill)
	b.at = now
	if b.tokens &gt;= 1 then
		b.tokens = b.tokens - 1
		return true
	end
	return false
end

function Utility.clearRate(key)
	buckets[key] = nil
end

-- Audio ----------------------------------------------------------------------
-- Placeholder hooks: play nothing until ids are configured. Sounds are created
-- locally in SoundService so they never replicate (zero network cost).
local sounds = {}

function Utility.play(category, volume)
	local id = Config.Audio[category]
	if id == nil or id == "" then
		return -- silent placeholder hook
	end
	local SoundService = game:GetService("SoundService")
	local snd = sounds[category]
	if snd == nil then
		snd = Instance.new("Sound")
		snd.Name = "SZ_" .. category
		snd.Looped = false
		snd.Parent = SoundService
		sounds[category] = snd
	end
	snd.SoundId = id
	snd.Volume = volume or 0.5
	snd:Play()
end

-- Remote notification (server only) -------------------------------------------
-- One shared RemoteEvent carries every server-&gt;client message, keyed by k=...
-- so we never spawn a flood of separate RemoteEvents.
local notifyRemote

function Utility.notify(player, payload)
	if notifyRemote == nil then
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		notifyRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Notify")
	end
	if player then
		notifyRemote:FireClient(player, payload)
	else
		notifyRemote:FireAllClients(payload)
	end
end

-- Misc -----------------------------------------------------------------------
function Utility.characterHead(character)
	local head = character:FindFirstChild("Head")
	return head
end

function Utility.rootOf(character)
	return character:FindFirstChild("HumanoidRootPart")
end

function Utility.humanoidOf(character)
	return character:FindFirstChildOfClass("Humanoid")
end

return Utility
</string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="RBX65">
      <Properties>
        <string name="Name">Remotes</string>
      </Properties>
      <Item class="RemoteEvent" referent="RBX66">
