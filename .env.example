# ============================================================
# FGx — BloxStrike Clan Discord Platform
# Copy this file to `.env` and fill in your values.
# NEVER commit the real .env file. It is git-ignored.
# ============================================================

# --- Discord (required) ---
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (Client) ID from the Developer Portal
CLIENT_ID=
# Guild ID for guild-scoped command registration.
# Leave empty to register commands globally instead.
GUILD_ID=

# --- Database ---
# Local SQLite file path (Node's built-in sqlite is used — no native deps).
# For cloud hosting, point this at a persistent volume.
DATABASE_PATH=data/fgx.db

# --- AI (optional; commands degrade gracefully when unset) ---
# Provider selection: '' (auto-detect from keys) | openai | gemini | groq
AI_PROVIDER=
# Key/model rotation strategy across configured keys and models:
#   failover   (default) — first working key/model, falls back on failure
#   roundrobin           — rotate through keys/models on every request
#   shuffle              — pick a random key/model per request
AI_FAILOVER_MODE=failover

# OpenAI-compatible provider (OpenAI, OpenRouter, Azure, local Ollama, ...)
# Single key + model, or comma-separated lists for key/model shuffling:
#   AI_KEYS=key1,key2   AI_MODELS=model1,model2
AI_API_KEY=
AI_KEYS=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MODELS=

# Google Gemini provider (https://aistudio.google.com/apikey)
# GEMINI_KEYS / GEMINI_MODELS accept comma-separated lists for shuffling.
GEMINI_API_KEY=
GEMINI_KEYS=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELS=

# Groq provider (https://console.groq.com/keys)
# GROQ_KEYS / GROQ_MODELS accept comma-separated lists for shuffling.
GROQ_API_KEY=
GROQ_KEYS=
GROQ_MODEL=groq/compound
GROQ_MODELS=

# Milliseconds before an AI request is aborted
AI_TIMEOUT_MS=30000
# AI moderation action mode: LOG (safest) | RECOMMEND | MODERATE
AI_ACTION_MODE=LOG

# --- Discord gateway intents ---
# full  = privileged intents (Server Members + Message Content) — required for
#         welcome/anti-raid and message scanning; enable in the Developer Portal
# basic = runs without privileged intents (degraded, but connects immediately)
DISCORD_INTENTS=full

# --- Dashboard / health endpoint ---
WEBHOOK_PORT=3000

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
# production | development
NODE_ENV=production
